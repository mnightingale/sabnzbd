{
  "defaults": {
    "server": {
      "host": "nntp",
      "port": 6791,
      "connections": 20,
      "ssl": 1,
      "username": "",
      "password": ""
    },
    "config": {
      "cache_limit": "1G",
      "direct_unpack": 0,
      "enable_par_cleanup": 1,
      "pause_on_post_processing": 0,
      "no_dupes": 0,
