      "pp": 0
    },
    {
      "name": "1000MB-full",
      "nzb": "https://sabnzbd.org/tests/test_download_1000MB.nzb",
      "pp": 3
    },
    {
      "name": "1000MB-dl-lowcache",
      "nzb": "https://sabnzbd.org/tests/test_download_1000MB.nzb",
      "pp": 0,
      "config": {
        "cache_limit": "256M"
      }
    },
    {
