          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1000 * rate(sabnzbd_span_seconds_total{span=\"decoder.decode\"}[$__rate_interval]) / clamp_min(rate(sabnzbd_span_calls_total{span=\"decoder.decode\"}[$__rate_interval]), 0.0001)",
